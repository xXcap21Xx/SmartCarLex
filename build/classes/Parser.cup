import java.util.ArrayList;
import java.util.List;
import compilerTools.Token;
import compilerTools.ASTNode;
import java_cup.runtime.*;

parser code {:
    public java.util.List<TError> errors = new java.util.ArrayList<>();

    private TError crearError(Symbol s, String mensajeBase) {
        int linea = s.left;
        int columna = s.right;
        String lexema;
        
        if (s.sym == sym.EOF) {
            lexema = "Fin de Archivo";
            if (linea == -1) { linea = 0; columna = 0; }
        } else if (s.value != null && s.value instanceof Token) {
            Token t = (Token) s.value;
            linea = t.getLine();
            columna = t.getColumn();
            lexema = t.getLexeme();
        } else {
            lexema = (s.value != null && !(s.value instanceof String)) ? s.value.toString() : "Token desconocido";
        }
        
        return new TError(linea, columna, mensajeBase + " '" + lexema + "'");
    }

    public void syntax_error(Symbol s) {
        errors.add(crearError(s, "Error Sintáctico: No se esperaba"));
    }

    public void unrecovered_syntax_error(Symbol s) {
        errors.add(crearError(s, "Error Fatal: Estructura incompleta cerca de"));
    }
:};

/* ====================== 1. TERMINALES ====================== */
terminal PROGRAM, INICIO, END, METODO, RUTINA, REGRESA;
terminal ENTRADA, SALIDA;
terminal CONST, SET, VAR;
terminal NUM, BOOL, STR; 
terminal CUANDO, SINO, MIENTRAS, LOOP, SALIR, SIGUE;
terminal MOVE, TURN, STOP, WAIT, ACCEL, DECEL, REVERSE, BRAKE;
terminal SENSOR, GPS, SPEED, DISTANCE, OBSTACLE;
terminal BROADCAST, RECEIVE, MESSAGE, EVENT, ON, VEHICLE_ID;
terminal ROUTE, WAYPOINT, GOTO, MAP, NAVIGATE, DESTINATION;
terminal TRUE, FALSE;
terminal Token ID, STRING, NUMBER;

terminal PLUS, MINUS, MUL, DIV, MOD, ASSIGN;
terminal EQ, NEQ, LT, GT, LE, GE, AND, OR, NOT;
terminal SEMI, COMMA, LPAREN, RPAREN, LBRACE, RBRACE, LBRACK, RBRACK;

/* ====================== 2. NO TERMINALES ====================== */
non terminal ASTNode S;
non terminal ASTNode contenido_programa, bloque_inicio, bloque_final;
non terminal ASTNode definiciones_principales, definicion;
non terminal ASTNode parametros_opc, parametros, parametro;
non terminal ASTNode sentencias_bloque, sentencia_completa;
non terminal ASTNode declaracion, inicializacion_opc, tipo;
non terminal ASTNode sentencia, asignacion, flujo, sino_opt, bloque_interno;
non terminal ASTNode accion, valor_accion;
non terminal ASTNode e_s, llamada, argumentos_opc, argumentos;
non terminal ASTNode expresion, expresion_simple, termino, factor, unario;
non terminal ASTNode bloque_mapa, ruta, valor_sensor, tipo_sensor, evento;

/* ====================== 3. PRECEDENCIA ====================== */
precedence left OR;
precedence left AND;
precedence left EQ, NEQ;
precedence left LT, GT, LE, GE;
precedence left PLUS, MINUS;
precedence left MUL, DIV, MOD;
precedence right NOT;
precedence nonassoc SINO; 

/* ====================== 4. GRAMÁTICA ====================== */

start with S;

S ::= 
    // A. CASO CORRECTO: program ID { ... }
    PROGRAM ID:id LBRACE contenido_programa:c RBRACE
    {: 
       ASTNode n = new ASTNode("Program: " + id.getLexeme());
       if(c != null) {
           // Copiamos los hijos del contenido al nodo principal
           for(ASTNode child : c.children) n.addChild(child);
       }
       RESULT = n;
    :}

    // B. ERROR: Falta el nombre del programa (program { ... })
    // Detectamos que después de 'program' sigue inmediatamente una llave '{'
    | PROGRAM LBRACE:lb contenido_programa:c RBRACE
    {: 
        parser.errors.add(new TError(lbleft, lbright, 
            "Error Sintáctico: El programa debe tener un nombre (ID) antes de abrir las llaves '{'."));
        RESULT = new ASTNode("Error_Raiz_SinID"); 
    :}
    
    // C. ERROR: Nombre inválido (program 123 { ... })
    // Detectamos que hay algo incorrecto entre 'program' y '{'
    | PROGRAM error:e LBRACE contenido_programa:c RBRACE
    {: 
        parser.errors.add(new TError(eleft, eright, 
            "Error Sintáctico: El nombre del programa es inválido. Se esperaba un identificador (ID)."));
        RESULT = new ASTNode("Error_Raiz_NombreInvalido"); 
    :}

    // D. ERROR: Falta abrir llaves (program ID ...)
    // Este ya lo tenías, detecta si falta el '{' después del ID
    | PROGRAM ID:id error
    {: 
       parser.errors.add(new TError(id.getLine(), id.getColumn(), 
           "Error Sintáctico: Falta abrir el bloque principal con '{' o error en la cabecera."));
       RESULT = new ASTNode("Error_Raiz_SinLlave");
    :}
    ;

contenido_programa ::=
    definiciones_principales:defs bloque_inicio:bi bloque_final:bf
    {:
       ASTNode n = new ASTNode("Contenido");
       if(defs != null) n.addChild(defs);
       if(bi != null) n.addChild(bi);
       if(bf != null) n.addChild(bf);
       RESULT = n;
    :}
    ;

/* --- BLOQUE INICIO PROTEGIDO --- */
bloque_inicio ::=
    INICIO LBRACE sentencias_bloque:s RBRACE
    {: 
       ASTNode n = new ASTNode("Inicio");
       if(s != null) n.addChild(s);
       RESULT = n;
    :}
    | error 
    {: 
       // Este error se dispara si no encuentra la palabra 'inicio'
       parser.errors.add(new TError(0, 0, "Error Sintáctico: Se requiere el bloque obligatorio 'inicio { ... }'"));
       RESULT = null;
    :}
    ;

/* --- BLOQUE FINAL PROTEGIDO --- */
bloque_final ::=
    END
    {: RESULT = new ASTNode("End"); :}
    | /* épsilon */
    {: 
       parser.errors.add(new TError(0, 0, "Error Sintáctico: Falta la palabra clave 'end' para cerrar el programa."));
       RESULT = null;
    :}
    ;

/* --- DEFINICIONES --- */
definiciones_principales ::= 
      definiciones_principales:list definicion:d
      {: if(d != null) list.addChild(d); RESULT = list; :}
    | /* epsilon */ 
      {: RESULT = new ASTNode("Definiciones"); :}
    ;

/* --- DEFINICIONES --- */
definicion ::= 
      METODO ID:id LPAREN parametros_opc:p RPAREN LBRACE sentencias_bloque:sb RBRACE
      {: 
         ASTNode n = new ASTNode("Metodo: " + id.getLexeme());
         if (p != null && !p.children.isEmpty()) n.addChild(p);
         if(sb != null) { for(ASTNode child : sb.children) n.addChild(child); }
         RESULT = n; 
      :}
    | RUTINA ID:id LBRACE sentencias_bloque:sb RBRACE
      {: 
         ASTNode n = new ASTNode("Rutina: " + id.getLexeme());
         if(sb != null) { for(ASTNode child : sb.children) n.addChild(child); }
         RESULT = n; 
      :}
    ;

/* --- PARÁMETROS --- */
parametros_opc ::= parametros:p {: RESULT = p; :} | /* epsilon */ {: RESULT = new ASTNode("Params"); :};

parametros ::= 
      parametros:list COMMA parametro:p
      {: list.addChild(p); RESULT = list; :}
    | parametro:p 
      {: ASTNode n = new ASTNode("Params"); n.addChild(p); RESULT = n; :}
    ;

parametro ::= tipo:t ID:id {: ASTNode n = new ASTNode("Param: " + id.getLexeme()); n.addChild(t); RESULT = n; :};

/* --- BLOQUES --- */
sentencias_bloque ::= 
      sentencias_bloque:list sentencia_completa:s
      {: if(s != null) list.addChild(s); RESULT = list; :}
    | /* epsilon */ {: RESULT = new ASTNode("Bloque"); :}
    ;

sentencia_completa ::= 
      declaracion:d {: RESULT = d; :}
    | sentencia:s   {: RESULT = s; :}
    // Si algo falla aquí, el parser busca el próximo ';' y se limpia.
    | error SEMI    {: RESULT = null; :} 
    ;

/* --- DECLARACIONES --- */
declaracion ::= 
      // Declaración normal: num x = 10;
      tipo:t ID:id inicializacion_opc:init SEMI
      {: 
         ASTNode n = new ASTNode("Decl: " + id.getLexeme());
         n.addChild(t); 
         if(init != null) n.addChild(init); 
         RESULT = n; 
      :}
    | tipo:t ID:id LBRACK NUMBER:n RBRACK SEMI
      {: 
         ASTNode node = new ASTNode("ArrayDecl: " + id.getLexeme()); 
         node.addChild(t); 
         // Ahora sí, 'n' se refiere al token NUMBER
         node.addChild(new ASTNode("Size: " + n.getLexeme()));
         RESULT = node; 
      :}
    | tipo:t ASSIGN expresion:e SEMI
      {: 
         // Reportamos el error usando las coordenadas del tipo 't'
         parser.errors.add(new TError(tleft, tright, 
            "Error Sintáctico: Falta el nombre de la variable (ID) en la declaración"));
         RESULT = null; // Retornamos null para que el árbol ignore esta línea errónea
      :}
    | tipo:t ID:id MAP LBRACK ruta:r RBRACK SEMI
      {: 
         parser.errors.add(new TError(id.getLine(), id.getColumn(), 
             "Error Sintáctico: Falta el operador de asignación '=' antes de definir el mapa."));
         RESULT = null; 
      :}
      
    | CONST ID:id ASSIGN expresion:e SEMI
      {: ASTNode n = new ASTNode("Const: " + id.getLexeme()); n.addChild(e); RESULT = n; :}
    | SET ID:id ASSIGN expresion:e SEMI
      {: ASTNode n = new ASTNode("Set: " + id.getLexeme()); n.addChild(e); RESULT = n; :}
    ;

inicializacion_opc ::= ASSIGN expresion:e {: RESULT = e; :} | /* epsilon */ {: RESULT = null; :};

tipo ::= 
      NUM  {: RESULT = new ASTNode("Type:Num"); :}
    | BOOL {: RESULT = new ASTNode("Type:Bool"); :}
    | STR  {: RESULT = new ASTNode("Type:Str"); :}
    | ROUTE {: RESULT = new ASTNode("Type:Route"); :} // <--- Nueva línea
    ;

/* --- SENTENCIAS --- */
sentencia ::= 
      asignacion:a  {: RESULT = a; :}
    | flujo:f       {: RESULT = f; :}
    | llamada:l     {: RESULT = l; :}
    | e_s:io        {: RESULT = io; :}
    | accion:ac     {: RESULT = ac; :}
    | bloque_mapa:bm {: RESULT = bm; :}
    | evento:ev     {: RESULT = ev; :}
    | REGRESA expresion:e SEMI {: ASTNode n = new ASTNode("Return"); n.addChild(e); RESULT = n; :}
    | SALIR SEMI    {: RESULT = new ASTNode("Break"); :}
    | SIGUE SEMI    {: RESULT = new ASTNode("Continue"); :}
    | definicion:d  {: RESULT = d; :}
    | SEMI          {: RESULT = null; :}
    ;

/* --- ASIGNACIÓN --- */
asignacion ::= 
      ID:id ASSIGN expresion:e SEMI 
      {: ASTNode n = new ASTNode("Assign: " + id.getLexeme()); n.addChild(e); RESULT = n; :}
      
    // Asignación a arreglo: lista[0] = 1;
    | ID:id LBRACK expresion:idx RBRACK ASSIGN expresion:val SEMI
      {: ASTNode n = new ASTNode("ArraySet: " + id.getLexeme()); n.addChild(idx); n.addChild(val); RESULT = n; :}
    ;

/* --- CONTROL DE FLUJO DEFINITIVO (CON DETECCIÓN DE EXPRESIONES INCOMPLETAS) --- */
flujo ::= 
    /* ==================== 1. CICLO MIENTRAS ==================== */
      
    // A. Sintaxis Correcta
      MIENTRAS LPAREN expresion:e RPAREN bloque_interno:b
      {: ASTNode n = new ASTNode("Mientras"); n.addChild(e); n.addChild(b); RESULT = n; :}

    // B. Error: Condición Vacía 'mientras()'
    | MIENTRAS LPAREN RPAREN bloque_interno:b
      {: parser.errors.add(new TError(bleft, bright, "Error Sintáctico: La condición del 'mientras' no puede estar vacía ().")); RESULT = null; :}

    // F. NUEVO: Expresión Incompleta/Mal Formada 'mientras ( x > )'
    // Esta regla atrapa cualquier error que ocurra DENTRO de los paréntesis
    | MIENTRAS LPAREN error:e RPAREN bloque_interno:b
      {: parser.errors.add(new TError(eleft, eright, "Error Sintáctico: La expresión del 'mientras' está incompleta o es inválida.")); RESULT = null; :}

    // C. TRAMPA: Falta paréntesis de cierre ')' -> mientras (expr { 
    | MIENTRAS LPAREN expresion:e bloque_interno:b
      {: 
         parser.errors.add(new TError(bleft, bright, "Error Sintáctico: Falta paréntesis de cierre ')' en el ciclo 'mientras'.")); 
         ASTNode n = new ASTNode("Mientras(Error)"); n.addChild(e); n.addChild(b); RESULT = n; 
      :}

    // D. Error: Falta paréntesis de apertura 'mientras expr )'
    | MIENTRAS error:e expresion:expr RPAREN bloque_interno:b
      {: parser.errors.add(new TError(eleft, eright, "Error Sintáctico: Falta paréntesis de apertura '(' en el ciclo 'mientras'.")); RESULT = null; :}


    /* ==================== 2. CONDICIONAL CUANDO ==================== */

    // A. Sintaxis Correcta
    | CUANDO LPAREN expresion:e RPAREN bloque_interno:b sino_opt:s
      {: ASTNode n = new ASTNode("Cuando"); n.addChild(e); n.addChild(b); if(s!=null) n.addChild(s); RESULT = n; :}

    // B. Error: Condición Vacía 'cuando()'
    | CUANDO LPAREN RPAREN bloque_interno:b sino_opt:s
      {: parser.errors.add(new TError(bleft, bright, "Error Sintáctico: La condición del 'cuando' no puede estar vacía ().")); RESULT = null; :}

    // F. NUEVO: Expresión Incompleta/Mal Formada 'cuando ( x == )'
    | CUANDO LPAREN error:e RPAREN bloque_interno:b sino_opt:s
      {: parser.errors.add(new TError(eleft, eright, "Error Sintáctico: La expresión del 'cuando' está incompleta o es inválida.")); RESULT = null; :}

    // C. TRAMPA: Falta paréntesis de cierre ')' -> cuando (expr {
    | CUANDO LPAREN expresion:e bloque_interno:b sino_opt:s
      {: 
         parser.errors.add(new TError(bleft, bright, "Error Sintáctico: Falta paréntesis de cierre ')' en 'cuando' antes del bloque.")); 
         ASTNode n = new ASTNode("Cuando(Error)"); n.addChild(e); n.addChild(b); if(s!=null) n.addChild(s); RESULT = n; 
      :}

    // D. Error: Falta paréntesis de apertura 'cuando expr )'
    | CUANDO error:e expresion:expr RPAREN bloque_interno:b sino_opt:s
      {: parser.errors.add(new TError(eleft, eright, "Error Sintáctico: Falta paréntesis de apertura '(' en 'cuando'.")); RESULT = null; :}


    /* ==================== 3. CICLO LOOP ==================== */
    
    // A. Sintaxis Correcta (Con condición) -> loop(x < 5)
    | LOOP LPAREN expresion:e RPAREN bloque_interno:b
      {: ASTNode n = new ASTNode("Loop"); n.addChild(e); n.addChild(b); RESULT = n; :}

    // B. Error: Condición Vacía -> loop()
    | LOOP LPAREN RPAREN bloque_interno:b
      {: parser.errors.add(new TError(bleft, bright, "Error Sintáctico: La condición del 'loop' no puede estar vacía.")); RESULT = null; :}

    // F. NUEVO: Expresión Incompleta/Mal Formada 'loop ( < 10 )'
    | LOOP LPAREN error:e RPAREN bloque_interno:b
      {: parser.errors.add(new TError(eleft, eright, "Error Sintáctico: La expresión del 'loop' está incompleta o es inválida.")); RESULT = null; :}

    // C. TRAMPA: Falta paréntesis de cierre ')' -> loop (expr {
    | LOOP LPAREN expresion:e bloque_interno:b
      {: 
         parser.errors.add(new TError(bleft, bright, "Error Sintáctico: Falta paréntesis de cierre ')' en el ciclo 'loop'.")); 
         ASTNode n = new ASTNode("Loop(Error)"); n.addChild(e); n.addChild(b); RESULT = n; 
      :}
    
    // D. Sintaxis Correcta (Infinito/Simple) -> loop { ... }
    | LOOP bloque_interno:b
      {: ASTNode n = new ASTNode("LoopInfinito"); n.addChild(b); RESULT = n; :}
    ;

/* --- SINO OPCIONAL --- */
sino_opt ::= 
      SINO bloque_interno:b 
      {: ASTNode n = new ASTNode("Sino"); n.addChild(b); RESULT = n; :}
    
    | /* epsilon */ {: RESULT = null; :}

    // Detectar: sino (condicion) o sino (basura) -> Error
    | SINO LPAREN error:e
      {: 
         parser.errors.add(new TError(eleft, eright, "Error Sintáctico: 'sino' NO lleva condición. Use 'sino cuando' o 'sino {'.")); 
         RESULT = null; 
      :}
    ;

/* --- BLOQUE INTERNO SIN CONFLICTOS --- */
bloque_interno ::= 
      LBRACE sentencias_bloque:sb RBRACE {: RESULT = sb; :}
    | sentencia_completa:s {: ASTNode n = new ASTNode("Bloque"); if(s!=null) n.addChild(s); RESULT = n; :}
    ;

llamada ::= 
    ID:id LPAREN argumentos_opc:args RPAREN SEMI 
    {: ASTNode n = new ASTNode("Call: " + id.getLexeme()); if(!args.children.isEmpty()) n.addChild(args); RESULT = n; :}
    ;

argumentos_opc ::= argumentos:a {: RESULT = a; :} | /* epsilon */ {: RESULT = new ASTNode("Args"); :};

argumentos ::= 
      argumentos:list COMMA expresion:e
      {: list.addChild(e); RESULT = list; :}
    | expresion:e 
      {: ASTNode n = new ASTNode("Args"); n.addChild(e); RESULT = n; :}
    ;

/* --- ENTRADA / SALIDA --- */
e_s ::= 
      // 1. Caso Correcto
      SALIDA LPAREN expresion:e RPAREN SEMI 
      {: ASTNode n = new ASTNode("Salida"); n.addChild(e); RESULT = n; :}
      
    // 2. Error: Paréntesis vacíos (Ahora con ubicación real)
    // Agregamos ':s' a SALIDA para capturar su posición
    | SALIDA:s LPAREN RPAREN SEMI
      {: 
         // Usamos sleft (línea) y sright (columna) en vez de 0,0
         parser.errors.add(new TError(sleft, sright, 
             "Error Sintáctico: La instrucción 'salida' requiere un mensaje o valor dentro de los paréntesis."));
         RESULT = null;
      :}
      
    // 3. Error: Contenido mal formado
    | SALIDA:s LPAREN error RPAREN SEMI
      {: 
         parser.errors.add(new TError(sleft, sright, 
             "Error en salida: Verifique comillas o argumentos"));
         RESULT = null;
      :}
    ;

/* --- ACCIONES CORREGIDO --- */
accion ::= 
      // Movimientos con valor opcional (move(10) o move;)
      MOVE valor_accion:v SEMI {: ASTNode n = new ASTNode("Move");
         if(v!=null) n.addChild(v); RESULT = n; :}
         
    | TURN valor_accion:v SEMI {: ASTNode n = new ASTNode("Turn");
         if(v!=null) n.addChild(v); RESULT = n; :}
         
    // Acciones simples sin parámetros
    | STOP SEMI {: RESULT = new ASTNode("Stop"); :}
    | ACCEL SEMI {: RESULT = new ASTNode("Action:Accel"); :}
    | DECEL SEMI {: RESULT = new ASTNode("Action:Decel"); :}
    | REVERSE SEMI {: RESULT = new ASTNode("Action:Reverse"); :}
    | BRAKE SEMI {: RESULT = new ASTNode("Action:Brake"); :}

    // WAIT: Esperar
    | WAIT LPAREN expresion:e RPAREN SEMI {: ASTNode n = new ASTNode("Wait"); n.addChild(e); RESULT = n; :}
    
    // Error Wait Vacío: wait();
    // AQUI ESTABA EL ERROR: Agregamos ':w' para poder usar wleft/wright
    | WAIT:w LPAREN RPAREN SEMI 
      {: parser.errors.add(new TError(wleft, wright, "Error Sintáctico: 'wait' requiere un valor numérico (segundos).")); RESULT = null; :}

    // BROADCAST: Enviar mensaje
    | BROADCAST LPAREN expresion:e RPAREN SEMI {: ASTNode n = new ASTNode("Broadcast"); n.addChild(e); RESULT = n; :}

    // Error Broadcast Vacío: broadcast();
    // AQUI TAMBIEN: Agregamos ':b' para poder usar bleft/bright
    | BROADCAST:b LPAREN RPAREN SEMI 
      {: parser.errors.add(new TError(bleft, bright, "Error Sintáctico: 'broadcast' requiere un mensaje para enviar.")); RESULT = null; :}
      
    // Error Broadcast Mal Formado
    | BROADCAST LPAREN error:e RPAREN SEMI
      {: 
         parser.errors.add(new TError(eleft, eright, "Error en broadcast: Verifique que las comillas del mensaje estén cerradas"));
         RESULT = null;
      :}
      
    // RECEIVE: Recibir mensaje en variable
    | RECEIVE LPAREN ID:id RPAREN SEMI {: ASTNode n = new ASTNode("Receive -> " + id.getLexeme());
         RESULT = n; :}
    ;

/* --- VALOR ACCIÓN --- */
valor_accion ::= 
      // 1. Caso Normal: (expresion)
      LPAREN expresion:e RPAREN {: RESULT = e; :} 

    // 2. Caso Vacío: move; (sin paréntesis)
    | /* epsilon */ {: RESULT = null; :}

    // 3. ERROR: Paréntesis vacíos -> move() o turn()
    | LPAREN:lp RPAREN 
      {: 
         parser.errors.add(new TError(lpleft, lpright, 
             "Error Sintáctico: La instrucción de movimiento requiere un valor (distancia/ángulo) dentro de los paréntesis."));
         RESULT = null; 
      :}
    ;

/* --- EXPRESIONES --- */
expresion ::= 
      // LÓGICA BOOLEANA (Recursiva sobre 'expresion' para permitir cadenas)
      expresion:e1 AND expresion:e2 {: ASTNode n = new ASTNode("&&"); n.addChild(e1); n.addChild(e2); RESULT = n; :}
    | expresion:e1 OR expresion:e2  {: ASTNode n = new ASTNode("||"); n.addChild(e1); n.addChild(e2); RESULT = n; :}
    
    // COMPARACIONES (Estas comparan valores numéricos/simples, devuelven booleano)
    | expresion_simple:e1 EQ expresion_simple:e2  {: ASTNode n = new ASTNode("=="); n.addChild(e1); n.addChild(e2); RESULT = n; :}
    | expresion_simple:e1 NEQ expresion_simple:e2 {: ASTNode n = new ASTNode("!="); n.addChild(e1); n.addChild(e2); RESULT = n; :}
    | expresion_simple:e1 LT expresion_simple:e2  {: ASTNode n = new ASTNode("<"); n.addChild(e1); n.addChild(e2); RESULT = n; :}
    | expresion_simple:e1 GT expresion_simple:e2  {: ASTNode n = new ASTNode(">"); n.addChild(e1); n.addChild(e2); RESULT = n; :}
    | expresion_simple:e1 LE expresion_simple:e2  {: ASTNode n = new ASTNode("<="); n.addChild(e1); n.addChild(e2); RESULT = n; :}
    | expresion_simple:e1 GE expresion_simple:e2  {: ASTNode n = new ASTNode(">="); n.addChild(e1); n.addChild(e2); RESULT = n; :}
    
    // Caso base (baja a aritmética)
    | expresion_simple:e {: RESULT = e; :}
    ;

expresion_simple ::= 
      expresion_simple:e PLUS termino:t  {: ASTNode n = new ASTNode("+"); n.addChild(e); n.addChild(t); RESULT = n; :}
    | expresion_simple:e MINUS termino:t {: ASTNode n = new ASTNode("-"); n.addChild(e); n.addChild(t); RESULT = n; :}
    | termino:t {: RESULT = t; :}
    ;

termino ::= 
      termino:t MUL factor:f {: ASTNode n = new ASTNode("*"); n.addChild(t); n.addChild(f); RESULT = n; :}
    | termino:t DIV factor:f {: ASTNode n = new ASTNode("/"); n.addChild(t); n.addChild(f); RESULT = n; :}
    | termino:t MOD factor:f {: ASTNode n = new ASTNode("%"); n.addChild(t); n.addChild(f); RESULT = n; :}
    | factor:f {: RESULT = f; :}
    ;

factor ::= 
      // 1. Llamada a función: id(args)
      ID:id LPAREN argumentos_opc:args RPAREN {: ASTNode n = new ASTNode("CallExpr: " + id.getLexeme());
      n.addChild(args); RESULT = n; :}
    
    // 2. Acceso a arreglo: id[idx]
    | ID:id LBRACK expresion:idx RBRACK {: ASTNode n = new ASTNode("ArrayGet: " + id.getLexeme()); n.addChild(idx); RESULT = n; :}
      
    | LPAREN expresion:e RPAREN {: RESULT = e; :}
    
    // 3. Variable simple: id
    | ID:id {: RESULT = new ASTNode("ID: " + id.getLexeme()); :}
    | NUMBER:n {: RESULT = new ASTNode("Val: " + n.getLexeme()); :}
    | STRING:s {: RESULT = new ASTNode("Val: " + s.getLexeme()); :}
    | TRUE {: RESULT = new ASTNode("Val: True"); :}
    | FALSE {: RESULT = new ASTNode("Val: False"); :}
    | unario:u {: RESULT = u; :}
    
    // Lecturas de Sistema
    | SPEED {: RESULT = new ASTNode("SystemRead:Speed"); :}
    | DISTANCE {: RESULT = new ASTNode("SystemRead:Distance"); :}
    | OBSTACLE {: RESULT = new ASTNode("SystemRead:Obstacle"); :}
    | GPS {: RESULT = new ASTNode("SystemRead:GPS"); :}
    | VEHICLE_ID {: RESULT = new ASTNode("SystemRead:VehicleID"); :}
    | GPS LPAREN RPAREN {: RESULT = new ASTNode("SystemRead:GPS_Call"); :}
    
    /* --- AQUÍ ESTABA EL DUPLICADO --- */
    // Regla correcta (solo debe estar UNA vez)
    | MAP LBRACK ruta:r RBRACK 
      {: ASTNode n = new ASTNode("MapExpr"); n.addChild(r); RESULT = n; :}

    // Regla de ERROR: Mapa vacío
    | MAP LBRACK RBRACK 
      {: 
         parser.errors.add(new TError(0, 0, "Error Sintáctico: El mapa no puede estar vacío. Debe contener al menos un 'waypoint'."));
         RESULT = new ASTNode("Error_Map_Vacio");
      :}
    ;

unario ::= 
      MINUS factor:f {: ASTNode n = new ASTNode("Neg"); n.addChild(f); RESULT = n; :}
    | NOT factor:f   {: ASTNode n = new ASTNode("Not"); n.addChild(f); RESULT = n; :}
    | valor_sensor:s {: RESULT = s; :}
    ;

bloque_mapa ::= 
      // Opción 1: Navegar a un ID (ej: navigate(destination = Casa);)
      NAVIGATE LPAREN DESTINATION ASSIGN ID:id RPAREN SEMI 
      {: ASTNode n = new ASTNode("Navigate"); n.addChild(new ASTNode(id.getLexeme())); RESULT = n; :}
      
      // Opción 2: Navegar a un String (ej: navigate(destination = "Almacen");) <-- ESTA FALTABA
    | NAVIGATE LPAREN DESTINATION ASSIGN STRING:s RPAREN SEMI 
      {: ASTNode n = new ASTNode("Navigate"); n.addChild(new ASTNode(s.getLexeme())); RESULT = n; :}
      
    | GOTO ID:id SEMI {: ASTNode n = new ASTNode("Goto: " + id.getLexeme()); RESULT = n; :}
    ;

valor_sensor ::= SENSOR LBRACK tipo_sensor:t RBRACK {: ASTNode n = new ASTNode("SensorRead"); n.addChild(t); RESULT = n; :};

tipo_sensor ::= 
      GPS {: RESULT = new ASTNode("Sensor:GPS"); :}
    | SPEED {: RESULT = new ASTNode("Sensor:Speed"); :}
    | DISTANCE {: RESULT = new ASTNode("Sensor:Distance"); :}
    | OBSTACLE {: RESULT = new ASTNode("Sensor:Obstacle"); :}
    ;

evento ::= ON EVENT bloque_interno:b {: ASTNode n = new ASTNode("OnEvent"); n.addChild(b); RESULT = n; :};

ruta ::= 
      WAYPOINT STRING:s COMMA ruta:r 
      {: ASTNode n = new ASTNode("WP: " + s.getLexeme()); n.addChild(r); RESULT = n; :}
    | WAYPOINT STRING:s 
      {: RESULT = new ASTNode("WP: " + s.getLexeme()); :}
    ;