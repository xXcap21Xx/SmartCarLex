import java.util.ArrayList;
import java.util.List;
import compilerTools.Token; // IMPORTANTE: Importar tu clase Token
import compilerTools.ASTNode;
import java_cup.runtime.*;

parser code {:
    // Lista de errores
    public java.util.List<TError> errors = new java.util.ArrayList<>();

    // Método auxiliar para extraer coordenadas seguras
    private TError crearError(Symbol s, String mensajeBase) {
        int linea = s.left;
        int columna = s.right;
        String lexema;
        
        if (s.sym == sym.EOF) {
            lexema = "Fin de Archivo";
            // Si por alguna razón JFlex falla y manda -1, forzamos un 0 o mensaje
            if (linea == -1) { 
                mensajeBase = mensajeBase + " (Final inesperado)"; 
                // Opcional: intentar usar una variable estática global para la última línea conocida
            }
        } else if (s.value != null && s.value instanceof Token) {
            Token t = (Token) s.value;
            linea = t.getLine();
            columna = t.getColumn();
            lexema = t.getLexeme();
        } else {
            lexema = (s.value != null) ? s.value.toString() : "Token desconocido";
        }
        
        return new TError(linea, columna, mensajeBase + " '" + lexema + "'");
    }

    // Error recuperable
    public void syntax_error(Symbol s) {
        errors.add(crearError(s, "Error Sintáctico: No se esperaba"));
    }

    // Error fatal
    public void unrecovered_syntax_error(Symbol s) {
        errors.add(crearError(s, "Error Fatal: Estructura incompleta o inesperada cerca de"));
    }
:}

/* ====================== TERMINALES ====================== */
// Estructura
terminal PROGRAM, INICIO, END, METODO, RUTINA, ENTRADA, SALIDA, REGRESA;
terminal NUM, BOOL, STR, VAR, CONST, SET;
terminal TRUE, FALSE;

// Control
terminal CUANDO, SINO, MIENTRAS, LOOP, SALIR, SIGUE;

// Vehículo
terminal MOVE, TURN, STOP, WAIT, ACCEL, DECEL, REVERSE, BRAKE;

// Sensores y Comunicación
terminal SENSOR, GPS, SPEED, DISTANCE, OBSTACLE;
terminal BROADCAST, RECEIVE, MESSAGE, EVENT, ON, VEHICLE_ID;

// Navegación
terminal ROUTE, WAYPOINT, GOTO, MAP, NAVIGATE, DESTINATION;

// Operadores
terminal EQ, NEQ, LE, GE, AND, OR, NOT;
terminal PLUS, MINUS, MUL, DIV, MOD, ASSIGN, LT, GT;

// Puntuación
terminal SEMI, COMMA, LPAREN, RPAREN, LBRACE, RBRACE, LBRACK, RBRACK;

// *** CORRECCIÓN: Usamos 'Token' porque el Lexer devuelve objetos Token, no Strings puros ***
terminal Token ID, STRING, NUMBER;

/* ====================== NO TERMINALES ====================== */
non terminal ASTNode program, main_block, block, statement_list, statement;
non terminal ASTNode declaration, assignment, flow_control, io_stmt;
non terminal ASTNode vehicle_cmd, nav_cmd, comm_cmd;
non terminal ASTNode expression, arguments, type;

/* ====================== PRECEDENCIA ====================== */
precedence left OR;
precedence left AND;
precedence left EQ, NEQ;
precedence left LT, GT, LE, GE;
precedence left PLUS, MINUS;
precedence left MUL, DIV, MOD;
precedence right NOT;
precedence nonassoc SINO; 

/* ====================== GRAMÁTICA ====================== */

start with program;

// Nota: Ahora 'name' es un objeto Token, usamos name.getLexeme()
program ::= 
    PROGRAM ID:name LBRACE main_block:mb RBRACE
    {: 
        ASTNode node = new ASTNode("Program: " + name.getLexeme());
        node.addChild(mb);
        RESULT = node; 
    :}
    ;

main_block ::= 
    INICIO block:b
    {: 
        ASTNode node = new ASTNode("Inicio");
        node.addChild(b);
        RESULT = node; 
    :}
    ;

block ::= 
    LBRACE statement_list:s RBRACE {: RESULT = s; :}
    | LBRACE RBRACE {: RESULT = new ASTNode("EmptyBlock"); :}
    ;

statement_list ::= 
      statement_list:list statement:s
      {: list.addChild(s); RESULT = list; :}
    | statement:s
      {: 
         ASTNode node = new ASTNode("Statements");
         node.addChild(s);
         RESULT = node; 
      :}
    ;

statement ::= 
      declaration:d     {: RESULT = d; :}
    | assignment:a      {: RESULT = a; :}
    | flow_control:f    {: RESULT = f; :}
    | vehicle_cmd:v SEMI {: RESULT = v; :} 
    | nav_cmd:n SEMI    {: RESULT = n; :}
    | comm_cmd:c SEMI   {: RESULT = c; :}
    | io_stmt:io SEMI   {: RESULT = io; :}
    | ID:id LPAREN arguments:args RPAREN SEMI 
      {: ASTNode n = new ASTNode("Call: " + id.getLexeme()); n.addChild(args); RESULT = n; :}
    | error SEMI        {: RESULT = new ASTNode("ErrorRecuperado"); :}
    ;

/* --- Declaraciones --- */
declaration ::= 
      type:t ID:id ASSIGN expression:e SEMI
      {: 
         ASTNode n = new ASTNode("DeclVar: " + id.getLexeme());
         n.addChild(t);
         n.addChild(e);
         RESULT = n; 
      :}
    | VAR ID:id ASSIGN expression:e SEMI
      {: ASTNode n = new ASTNode("VarDynamic: " + id.getLexeme()); n.addChild(e); RESULT = n; :}
    ;

type ::= 
      NUM   {: RESULT = new ASTNode("Type:Num"); :}
    | BOOL  {: RESULT = new ASTNode("Type:Bool"); :}
    | STR   {: RESULT = new ASTNode("Type:Str"); :}
    ;

/* --- Asignaciones --- */
assignment ::= 
      ID:id ASSIGN expression:e SEMI
      {: ASTNode n = new ASTNode("Assign: " + id.getLexeme()); n.addChild(e); RESULT = n; :}
    | SET ID:id ASSIGN expression:e SEMI
      {: ASTNode n = new ASTNode("Set: " + id.getLexeme()); n.addChild(e); RESULT = n; :}
    ;

/* --- IO --- */
io_stmt ::= 
      SALIDA LPAREN expression:e RPAREN {: ASTNode n = new ASTNode("Salida"); n.addChild(e); RESULT = n; :}
    ;

/* --- Control de Flujo --- */
flow_control ::= 
      CUANDO LPAREN expression:c RPAREN block:b1 SINO block:b2
      {: ASTNode n = new ASTNode("If-Else"); n.addChild(c); n.addChild(b1); n.addChild(b2); RESULT = n; :}
    | CUANDO LPAREN expression:c RPAREN block:b1
      {: ASTNode n = new ASTNode("If"); n.addChild(c); n.addChild(b1); RESULT = n; :}
    | MIENTRAS LPAREN expression:c RPAREN block:b
      {: ASTNode n = new ASTNode("While"); n.addChild(c); n.addChild(b); RESULT = n; :}
    | LOOP LPAREN expression:e RPAREN block:b
      {: ASTNode n = new ASTNode("Loop"); n.addChild(e); n.addChild(b); RESULT = n; :}
    ;

/* --- Comandos Vehículo --- */
vehicle_cmd ::= 
      MOVE LPAREN expression:e RPAREN {: ASTNode n = new ASTNode("Move"); n.addChild(e); RESULT = n; :}
    | TURN LPAREN expression:e RPAREN {: ASTNode n = new ASTNode("Turn"); n.addChild(e); RESULT = n; :}
    | STOP {: RESULT = new ASTNode("Stop"); :} 
    | BRAKE {: RESULT = new ASTNode("Brake"); :}
    | ACCEL LPAREN expression:e RPAREN {: ASTNode n = new ASTNode("Accel"); n.addChild(e); RESULT = n; :}
    | WAIT LPAREN expression:e RPAREN  {: ASTNode n = new ASTNode("Wait"); n.addChild(e); RESULT = n; :}
    ;

nav_cmd ::= 
      GOTO LPAREN expression:e RPAREN {: ASTNode n = new ASTNode("Goto"); n.addChild(e); RESULT = n; :}
    ;

comm_cmd ::= 
      BROADCAST LPAREN expression:e RPAREN {: ASTNode n = new ASTNode("Broadcast"); n.addChild(e); RESULT = n; :}
    ;

/* --- Expresiones --- */
expression ::= 
      expression:e1 PLUS expression:e2   {: ASTNode n = new ASTNode("+"); n.addChild(e1); n.addChild(e2); RESULT = n; :}
    | expression:e1 MINUS expression:e2  {: ASTNode n = new ASTNode("-"); n.addChild(e1); n.addChild(e2); RESULT = n; :}
    | expression:e1 MUL expression:e2    {: ASTNode n = new ASTNode("*"); n.addChild(e1); n.addChild(e2); RESULT = n; :}
    | expression:e1 EQ expression:e2     {: ASTNode n = new ASTNode("=="); n.addChild(e1); n.addChild(e2); RESULT = n; :}
    | expression:e1 LT expression:e2     {: ASTNode n = new ASTNode("<"); n.addChild(e1); n.addChild(e2); RESULT = n; :}
    | expression:e1 GT expression:e2     {: ASTNode n = new ASTNode(">"); n.addChild(e1); n.addChild(e2); RESULT = n; :}
    | SENSOR LPAREN OBSTACLE RPAREN      {: RESULT = new ASTNode("Sensor:Obstacle"); :}
    | SENSOR LPAREN DISTANCE RPAREN      {: RESULT = new ASTNode("Sensor:Distance"); :}
    
    /* Corrección aquí también: extraemos el lexema del Token */
    | NUMBER:n {: RESULT = new ASTNode("Num: " + n.getLexeme()); :}
    | STRING:s {: RESULT = new ASTNode("Str: " + s.getLexeme()); :}
    | ID:id    {: RESULT = new ASTNode("ID: " + id.getLexeme()); :}
    | TRUE     {: RESULT = new ASTNode("True"); :}
    | FALSE    {: RESULT = new ASTNode("False"); :}
    ;

arguments ::= 
      arguments:list COMMA expression:e {: list.addChild(e); RESULT = list; :}
    | expression:e {: ASTNode n = new ASTNode("Args"); n.addChild(e); RESULT = n; :}
    | /* vacio */ {: RESULT = new ASTNode("NoArgs"); :}
    ;