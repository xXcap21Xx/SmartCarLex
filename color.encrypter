program DemoCiclos {

    inicio {

    // Declaraciones globales permitidas
    num contador = 0;
    num energia = 100;
    bool sistema_activo = true;

        salida("Iniciando pruebas de ciclos...");

        // -------------------------------------------------------
        // 1. CICLO MIENTRAS (While Standard)
        // -------------------------------------------------------
        // Si quitas el '(' o ')', el parser ahora te dirá exactamente cuál falta.
        mientras (contador < 3) {
            salida("Contador MIENTRAS actual:");
            salida(contador);
            
            contador = contador + 1;
            energia = energia - 10;
            wait(1);
        }

        // -------------------------------------------------------
        // 2. CICLO LOOP CON CONDICIÓN (Tipo Repeat/Until)
        // -------------------------------------------------------
        salida("--- Entrando a LOOP condicional ---");
        
        loop (energia > 50) {
            salida("Consumiendo energía en LOOP...");
            salida(energia);
            energia = energia - 20;
        }

        // -------------------------------------------------------
        // 3. CICLO LOOP SIMPLE (Bloque infinito/continuo)
        // -------------------------------------------------------
        // Tu gramática también permite 'loop { ... }' sin paréntesis
        // Si olvidas la llave '{', ahora recibirás el error: "Falta abrir el bloque..."
        
        loop {
            salida("Ejecutando bloque LOOP simple");

            // Estructura CUANDO anidada para probar bloques internos
            cuando (energia <= 50) {
                salida("Energía baja detectada. Deteniendo sistema.");
                sistema_activo = false;
            }

            // Condición de salida para no quedarnos pegados
            cuando (sistema_activo == false) {
                stop; // Detiene la ejecución del programa
            }
        }
    }
    end
}