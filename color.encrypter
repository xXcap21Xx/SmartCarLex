program SistemaDeNavegacionReactiva {
    
    // ==========================================================
    // DECLARACIONES GLOBALES (No definidas en esta versión de gramática, 
    // pero las ubicamos aquí por contexto. En esta versión, van en INICIO)
    // ==========================================================

    // ==========================================================
    // DEFINICIÓN DE MÉTODOS Y RUTINAS
    // ==========================================================
    
    // Método que simula la revisión de un estado (ej: batería)
    metodo revisarBateria(num nivel_actual) {
        
        bool estado_critico = nivel_actual < 10;
        
        cuando (estado_critico == true) {
            regresa true; // Batería baja
        } sino {
            regresa false; // Batería OK
        }
    }
    
    // Rutina para manejar el frenado y la alerta de peligro
    rutina alertaDePeligro {
        
        stop;
        brake;
        broadcast(message = "Peligro: Detención de Emergencia");
    }
    
    // ==========================================================
    // BLOQUE PRINCIPAL (INICIO)
    // ==========================================================
    
    inicio {
        
        // Declaraciones de Variables Locales
        num velocidad_maxima = 70;
        num bateria_nivel = 100;
        bool en_peligro;
        num distancia_sensor;
        
        // 1. Configuración de la Ruta de Navegación
        salida("Configurando ruta...");
        map ruta_principal[waypoint "WP1", waypoint "WP2", waypoint "WP3", waypoint "Final"];
        navigate(destination = "Final");
        
        // 2. Bucle principal de control del vehículo (Ciclo LOOP)
        loop {
            
            // --- Lectura de Sensores ---
            distancia_sensor = sensor[distance];
            en_peligro = sensor[obstacle];
            bateria_nivel = bateria_nivel - 1; // Simulación de consumo

            // --- Llamada a Método y Asignación
            bool bateria_baja = revisarBateria(bateria_nivel);
            
            // --- Control de Flujo Lógico ---
            
            cuando (bateria_baja == true) {
                
                alertaDePeligro();
                salida("ERROR: Batería baja. Detenido.");
                
            } sino {
                
                // Si la batería está bien, checamos obstáculos/distancia
                
                cuando (en_peligro == true || distancia_sensor <= 5) {
                    
                    // Llamada a Rutina de Alerta
                    alertaDePeligro(); 
                    salida("Obstáculo o distancia crítica.");
                    
                } sino {
                    
                    // Si no hay peligro, aceleramos hasta el límite
                    mientras (sensor[speed] < velocidad_maxima) {
                        accelerate;
                    }
                    move 5; // Mover hacia adelante
                    
                }
            }
            
            // Esperar un momento antes de la siguiente iteración
            wait(1); 
            
            // 3. Recepción de mensajes externos (interacción)
            str mensaje_externo;
            receive(message = mensaje_externo);
            
            cuando (mensaje_externo == "RUTA_CANCELADA") {
                salida("Recibido: Ruta Cancelada. Deteniendo.");
                break;
            }
        }
        
    } end 
}