program SistemaDeNavegacionReactiva {
    
    // 1. DEFINICIONES
    metodo revisarBateria(num nivel_actual) {
        bool estado_critico = nivel_actual < 10;
        cuando (estado_critico == true) {
            regresa true;
        } sino {
            regresa false;
        }
    }
    
    rutina alertaDePeligro {
        stop;
        brake;
        // Eliminamos "message ="
        broadcast("Peligro: Detención de Emergencia");
    }
    
    // 2. INICIO
    inicio {
        num velocidad_maxima = 70;
        num bateria_nivel = 100;
        bool en_peligro = false;
        num distancia_sensor = 20;
        
        salida("Configurando ruta...");
        
        // Ajustamos a la sintaxis simple de tu Parser.cup
        // map["WP1", "WP2", "Final"]; 
        navigate(destination = "Punto_B");

        mientras (bateria_nivel > 0) {
            
            bateria_nivel = bateria_nivel - 1;
            distancia_sensor = sensor[distance];
            
            cuando (bateria_nivel < 10) {
                alertaDePeligro();
                salida("ERROR: Batería baja.");
                stop;
            } sino {
                cuando (distancia_sensor <= 5) {
                    alertaDePeligro();
                    salida("Obstáculo detectado.");
                } sino {
                    mientras (speed < velocidad_maxima) {
                        accelerate; // Usamos el token de acción
                    }
                    move(5); // Agregamos paréntesis
                }
            }

            wait(1); 
            
            str mensaje_externo;
            // Eliminamos "message ="
            receive(mensaje_externo);
            
            cuando (mensaje_externo == "CANCELAR") {
                salida("Ruta Cancelada.");
                salir; // Cambiamos break por salir
            }
        }
    } 
    end 
}